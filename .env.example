# Copia estas variables al panel Environment del Compose en Dokploy.
# Origen publico HTTPS, SIN barra final ni ruta.
FRONTEND_URL=https://marketplace.example.com

# Genera CADA secreto por separado con: openssl rand -hex 32
# Se recomienda hexadecimal; las contrasenas ya no se insertan en URLs.
# Si usas $ o #, conserva el valor literal con comillas simples en este panel.
POSTGRES_PASSWORD=replace_with_unique_64_hex_characters
IDENTITY_DATABASE_PASSWORD=replace_with_unique_64_hex_characters
CATALOG_DATABASE_PASSWORD=replace_with_unique_64_hex_characters
MESSAGING_DATABASE_PASSWORD=replace_with_unique_64_hex_characters
BETTER_AUTH_SECRET=replace_with_unique_64_hex_characters

# Google OAuth: redirect autorizado
# https://marketplace.example.com/api/v1/identity/auth/callback/google
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret

# Media / UploadThing
UPLOADTHING_TOKEN=replace_with_uploadthing_token

# PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE y BETTER_AUTH_URL se definen en el Compose.
# Las variables VITE se derivan de FRONTEND_URL durante el build.
